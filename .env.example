# Copy to .env and adjust as needed.
#
# These values are used by docker compose (interpolated into the api service
# environment) and by the backend when running outside Docker (uv run /
# uvicorn on the host). Compose overrides DATABASE_URL's host with the `db`
# service name; for local backend development use localhost (as below).

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ledgerlens

# --- Anthropic (LLM categorizer, placeholder) --------------------------------
ANTHROPIC_API_KEY=

# --- Auth --------------------------------------------------------------------
JWT_SECRET=dev-only-secret-change-me-32-bytes-min
JWT_EXPIRE_MINUTES=60
